# Copy to .env (never commit it). Real environment variables win over this file.
{{PROJECT_ENV}}_API_URL=http://localhost:3000
{{PROJECT_ENV}}_WEB_URL=http://localhost:3000
{{PROJECT_ENV}}_USERNAME=
{{PROJECT_ENV}}_PASSWORD=
# A local OpenAPI file instead of fetching {{PROJECT_ENV}}_API_URL/openapi.json
{{PROJECT_ENV}}_SPEC_FILE=
# 1 lets browser runs and the API MCP server change data. Leave unset for shared environments.
{{PROJECT_ENV}}_ALLOW_WRITES=
