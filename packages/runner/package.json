{
  "name": "@qakit/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scenario runner of the QA automation kit: defineApiScenario / defineUiScenario, discovery under paths.suites, reports and the run store.",
  "exports": {
