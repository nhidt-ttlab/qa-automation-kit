  "dependencies": {
    "@qakit/core": "workspace:*",
    "@qakit/desktop": "workspace:*",
    "@qakit/ui": "workspace:*",
    "tsx": "^4.19.2"
  },
  "peerDependencies": {
    "playwright": ">=1.62.0"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22.5.0"
  }
