{
  "name": "@qakit/mcp-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API MCP server of the QA automation kit: domain discovery, OpenAPI-ranked actions, planning and a write-gated executor, plus API doc generation.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
