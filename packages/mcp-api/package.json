  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@qakit/core": "workspace:*",
    "openapi-types": "^12.1.3",
    "yaml": "^2.6.1",
    "zod": "3.25.76"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
