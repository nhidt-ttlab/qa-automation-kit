# Reporting API settings. Copy to .env next to where the API runs, or to $REPORTING_DATA_DIR/.env
# when a project deploys the kit app with its state in its own folder.
#
# REPORTING_DATA_DIR itself must come from the process environment (it says where this file is).
# Every relative path below resolves against it, or against the process cwd when it is unset.

PORT=3000

# Prisma database URL (Postgres).
# Format: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=postgresql://qakit:qakit@localhost:5432/qakit_reporting?schema=public

# Frontend CORS origin
CORS_ORIGIN=http://localhost:5173

# Product name used in the Swagger title.
REPORTING_TITLE=QA Reporting

# Redmine integration (the first IssueTracker implementation)
REDMINE_URL=https://redmine.example.com
REDMINE_API_KEY=your_redmine_api_key_here

# The regression runner checkout: where `db:sync` reads runs and evidence, and what regression jobs spawn.
REGRESSION_RUNNER_PATH=../runner

# How regression jobs invoke the runner, relative to REGRESSION_RUNNER_PATH. The defaults below fit a
# tsx runner checkout; uncomment and change them for another layout.
# REGRESSION_RUNNER_SCRIPT=src/entrypoints/run-suite.ts
# The tsx CLI the script runs under, or "none" to run a compiled script on plain node.
# REGRESSION_RUNNER_TSX=node_modules/tsx/dist/cli.mjs
# Leading args for every invocation (whitespace-separated, no quoting).
# REGRESSION_RUNNER_ARGS=
# Environment files: a directory and a file name with {env} for the environment name.
# REGRESSION_RUNNER_ENVIRONMENTS_DIR=configs/environments
# REGRESSION_RUNNER_ENVIRONMENT_FILE={env}.json
# Or a fixed, comma-separated environment list that needs no file per environment.
# REGRESSION_RUNNER_ENVIRONMENTS=
# Where seeded-session locks and job cancel flags live.
# REGRESSION_RUNNER_SESSIONS_DIR=.sessions
#
# A qakit project (qakit.config.yaml) runs the kit's runner instead:
# REGRESSION_RUNNER_SCRIPT=node_modules/@qakit/runner/dist/bin.js
# REGRESSION_RUNNER_TSX=none
# REGRESSION_RUNNER_ARGS=--config qakit.config.yaml
# REGRESSION_RUNNER_ENVIRONMENTS=local

# Source SQLite file for `db:sync`. Defaults to <REGRESSION_RUNNER_PATH>/db/regression.db when unset.
REGRESSION_SQLITE_PATH=

# The runner's switch names, and where it sits in the repository (for scenario paths in review CSVs).
# RUNNER_WRITES_ENV=QAKIT_ALLOW_WRITES
# RUNNER_CANCEL_FILE_ENV=QAKIT_CANCEL_FILE
# RUNNER_SCENARIO_PATH_PREFIX=tests/qa

# Where `db:sync` copies UI evidence (screenshots, video, trace, HAR, console) out of the runner,
# and where the API serves it from.
EVIDENCE_STORAGE_PATH=./storage/evidence

# Node environment
NODE_ENV=development

# Mandatory custom fields for the target tracker, as a JSON array of { id, value }.
# Redmine has no non-admin endpoint listing custom field definitions, so read the ids off an
# existing issue: GET /issues.json?project_id=<key>&tracker_id=<id>&limit=1
REDMINE_DEFAULT_CUSTOM_FIELDS=[{"id":24,"value":"QA/BA"},{"id":43,"value":"YOUR_PROJECT_CODE"}]
# Default "Target version" name when the request omits target_version.
# Names: GET /projects/<key>/versions.json
REDMINE_DEFAULT_VERSION=

# Where regression job logs are written as JSONL (one file per job).
JOB_LOG_STORAGE_PATH=./storage/job-logs
# Safety nets for a runaway batch. Defaults: 6h overall, 20min without any output.
REGRESSION_JOB_TIMEOUT_MS=21600000
REGRESSION_JOB_INACTIVITY_TIMEOUT_MS=1200000
