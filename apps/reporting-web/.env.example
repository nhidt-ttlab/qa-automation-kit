# Reporting web settings, baked in at build time. Copy to .env here, or into $REPORTING_WEB_ENV_DIR
# when a project keeps its build settings in its own folder.

VITE_API_URL=http://localhost:3000
VITE_ENV=development

# Product name in the browser tab, title bar, sidebar and footer.
VITE_APP_TITLE=QA Reporting

# Redmine project used by the "Log Bug to Redmine" button (tracker defaults to "Bug").
# The *identifier* from the project URL (/projects/<identifier>), not the display name —
# the REST API rejects the display name with a 404.
VITE_REDMINE_PROJECT_KEY=
